{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pirc:schema:v1:economic-settlement",
  "title": "PiRC Economic Settlement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "period_id", "asset_id", "accounting_unit", "collected_revenue", "deductions", "distributable", "allocations", "status"],
  "properties": {
    "schema": {"const": "pirc.economic-settlement"},
    "version": {"const": "1.0.0"},
    "period_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "accounting_unit": {"const": "integer_atomic_units"},
    "collected_revenue": {"$ref": "#/$defs/amount"},
    "deductions": {"type":"object","additionalProperties":false,"required":["operating_costs","taxes","due_liabilities_and_refunds","reserve_replenishment","committed_distributions_and_capex"],"properties":{"operating_costs":{"$ref":"#/$defs/amount"},"taxes":{"$ref":"#/$defs/amount"},"due_liabilities_and_refunds":{"$ref":"#/$defs/amount"},"reserve_replenishment":{"$ref":"#/$defs/amount"},"committed_distributions_and_capex":{"$ref":"#/$defs/amount"}}},
    "distributable": {"$ref": "#/$defs/amount"},
    "allocations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["participant_id","amount"],"properties":{"participant_id":{"type":"string","minLength":1},"amount":{"$ref":"#/$defs/amount"}}}},
    "status": {"enum": ["CALCULATED", "UNDERFUNDED", "RECONCILIATION_REQUIRED", "SETTLED"]},
    "evidence_ref": {"type":["string","null"]}
  },
  "$defs": {"amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)$","description":"Base-10 integer atomic units; no sign, decimal point, exponent, or leading zero."}}
}
